#. Translators: Used in server mode to obtain the external IP address for the server (controlled computer) for direct connection.
#: addon\globalPlugins\remoteClient\dialogs.py:186
msgid "Get External &IP"
msgstr "&Извлечи външния IP адрес"

#. Translators: Label of the field displaying the external IP address if using direct (client to server) connection.
#: addon\globalPlugins\remoteClient\dialogs.py:190
msgid "&External IP:"
msgstr "&Външен IP адрес:"

#. Translators: label of a checkbox which allows forwarding a port using UPNP
#: addon\globalPlugins\remoteClient\dialogs.py:198
#: addon\globalPlugins\remoteClient\dialogs.py:413
msgid "Use &UPNP to forward this port if possible"
msgstr "Използвай &UPNP, за препращане на този порт, ако е възможно"

#. Translators: message asking the user wether perform portcheck with UPNP or not
#: addon\globalPlugins\remoteClient\dialogs.py:225
msgid ""
"Would you like to use UPNP to forward the chosen port before detecting your "
"IP address?"
msgstr ""
"Искате ли да използвате UPNP, за да препратите избрания порт, преди да "
"установите вашия IP адрес?"

#. Translators: title of the message asking the user to try portcheck with UPNP
#: addon\globalPlugins\remoteClient\dialogs.py:227
msgid "Do you want to use UPNP?"
msgstr "Искате ли да използвате UPNP?"

#: addon\globalPlugins\remoteClient\dialogs.py:271
#, python-brace-format
msgid "Successfully retrieved IP address. Port {port} is open."
msgstr "Успешно извлечен IP адрес. Портът {port} е отворен."

#: addon\globalPlugins\remoteClient\dialogs.py:271
msgid "Success"
msgstr "Операцията беше успешна"

#: addon\globalPlugins\remoteClient\dialogs.py:273
#, python-brace-format
msgid "Retrieved external IP, but port {port} is not currently forwarded."
msgstr "Получен е външен IP, но в момента портът {port} не е отворен."

#. Translators: The title of the warning dialog displayed when handle keys from other applications is disabled.
#: addon\globalPlugins\remoteClient\dialogs.py:273
#: addon\globalPlugins\remoteClient\__init__.py:933
msgid "Warning"
msgstr "Предупреждение"

#: addon\globalPlugins\remoteClient\dialogs.py:280
msgid ""
"Unable to contact portcheck server or UPNP device, please manually retrieve "
"your IP address and forward ports if required. See the NVDA log for more "
"details."
msgstr ""
"Свързването със сървъра на portcheck или UPNP устройството е невъзможно. "
"Моля, извлечете ръчно своя IP адрес. Вижте протоколния файл на NVDA за "
"повече информация."

#: addon\globalPlugins\remoteClient\dialogs.py:287
msgid "Client"
msgstr "Клиент"

#: addon\globalPlugins\remoteClient\dialogs.py:287
msgid "Server"
msgstr "Сървър"

#: addon\globalPlugins\remoteClient\dialogs.py:291
#: addon\globalPlugins\remoteClient\dialogs.py:375
msgid "Control another machine"
msgstr "Управляване на друга машина"

#: addon\globalPlugins\remoteClient\dialogs.py:291
#: addon\globalPlugins\remoteClient\dialogs.py:375
msgid "Allow this machine to be controlled"
msgstr "Позволяване тази машина да бъде управлявана"

#: addon\globalPlugins\remoteClient\dialogs.py:319
#: addon\globalPlugins\remoteClient\dialogs.py:645
msgid "Both host and key must be set."
msgstr "Домакинът и ключът трябва да бъдат указани."

#. Translators: error message for key/password length less than 6 characters
#: addon\globalPlugins\remoteClient\dialogs.py:323
#: addon\globalPlugins\remoteClient\dialogs.py:337
#: addon\globalPlugins\remoteClient\dialogs.py:652
msgid "The key must be longer than 6 characters."
msgstr "Ключът трябва да е по-дълъг от 6 символа."

#. Translators: error message for key/password being sequential, example 123456
#: addon\globalPlugins\remoteClient\dialogs.py:328
#: addon\globalPlugins\remoteClient\dialogs.py:342
#: addon\globalPlugins\remoteClient\dialogs.py:657
msgid ""
"The key must not be sequential. Please, avoid keys such as 1234, 4321 or "
"similar."
msgstr ""
"Ключът не трябва да е последователен. Моля, избягвайте клавиши като 1234, "
"4321 или други подобни."

#: addon\globalPlugins\remoteClient\dialogs.py:333
#: addon\globalPlugins\remoteClient\dialogs.py:648
msgid "Both port and key must be set."
msgstr "Портът и ключът трябва да бъдат указани."

#. Translators: title for the TeleNVDA settings category in NVDA settings dialog
#. Translators: script category for add-on gestures
#: addon\globalPlugins\remoteClient\dialogs.py:350
#: addon\globalPlugins\remoteClient\__init__.py:78
#: addon\globalPlugins\remoteClient\__init__.py:427
msgid "TeleNVDA"
msgstr "TeleNVDA"

#. Translators: A checkbox in add-on options dialog to set whether remote server is started when NVDA starts.
#: addon\globalPlugins\remoteClient\dialogs.py:354
msgid "Auto-connect to control server on startup"
msgstr "Автоматично се свързвай към управляващия сървър при стартиране"

#. Translators: A checkbox in add-on options dialog to enable update checks when NVDA starts.
#: addon\globalPlugins\remoteClient\dialogs.py:358
msgid "Check for TeleNVDA updates on startup"
msgstr "Проверете за актуализации на TeleNVDA при стартиране"

#: addon\globalPlugins\remoteClient\dialogs.py:364
msgid "Update channel"
msgstr "Актуализирайте канала"

#: addon\globalPlugins\remoteClient\dialogs.py:365
msgid "Stable releases"
msgstr "Стабилни версии"

#: addon\globalPlugins\remoteClient\dialogs.py:365
msgid "Development releases"
msgstr "Издания за разработка"

#. Translators: Whether or not to use a relay server when autoconnecting
#: addon\globalPlugins\remoteClient\dialogs.py:370
msgid "Use Remote Control Server"
msgstr "Използвай сървър за отдалечено управление"

#: addon\globalPlugins\remoteClient\dialogs.py:370
msgid "Host Control Server"
msgstr "Управляващ сървър домакин"

#. Translators: A checkbox in add-on options dialog to set whether auto-connect is automatically turned off after a configurable period without any real remote control activity.
#: addon\globalPlugins\remoteClient\dialogs.py:381
msgid "Automatically disable auto-connect without any remote control activity"
msgstr "Автоматично деактивирайте автоматичното свързване без никакво дистанционно управление"

#. Translators: Label for the inactivity duration field. The value uses days:hours:minutes.
#: addon\globalPlugins\remoteClient\dialogs.py:386
msgid "Inactivity duration (days:hours:minutes):"
msgstr "Продължителност на неактивност (дни:часове:минути):"

#: addon\globalPlugins\remoteClient\dialogs.py:392
msgid ""
"Format: days:hours:minutes. For example, 30:00:00 means 30 days and 00:00:01 "
"means 1 minute."
msgstr "Формат: дни:часове:минути. Например 30:00:00 означава 30 дни, а 00:00:01 означава 1 минута."

#. Translators: label of the port used to reach the relay or server, as opposed to the proxy port below.
#: addon\globalPlugins\remoteClient\dialogs.py:406
msgid "&Port (server/relay):"
msgstr "&Порт (сървър/реле):"

#. Translators: tooltip clarifying that this port is used to reach the relay/server, not the proxy below.
#: addon\globalPlugins\remoteClient\dialogs.py:410
msgid ""
"Port used to reach the relay or server (default 6837, or 443 for WebSocket "
"over HTTPS). Unrelated to the proxy port below."
msgstr "Порт, използван за достигане до релето или сървъра (по подразбиране 6837 или 443 за WebSocket през HTTPS). Без връзка с прокси порта по-долу."

#: addon\globalPlugins\remoteClient\dialogs.py:429
msgid "Proxy &mode:"
msgstr "Прокси &режим:"

#: addon\globalPlugins\remoteClient\dialogs.py:434
msgid "Manual configuration"
msgstr "Ръчна конфигурация"

#: addon\globalPlugins\remoteClient\dialogs.py:435
msgid "Automatic Windows proxy detection"
msgstr "Автоматично откриване на Windows прокси"

#: addon\globalPlugins\remoteClient\dialogs.py:436
msgid "No proxy"
msgstr "Няма прокси"

#: addon\globalPlugins\remoteClient\dialogs.py:443
msgid "HTTP/SOCKS &proxy host:"
msgstr "HTTP/SOCKS &прокси хост:"

#: addon\globalPlugins\remoteClient\dialogs.py:447
msgid "Proxy por&t:"
msgstr "Прокси por&t:"

#. Translators: tooltip clarifying that this port is the intermediary proxy port, not the relay/server port above.
#: addon\globalPlugins\remoteClient\dialogs.py:451
msgid ""
"Port of an intermediary HTTP/SOCKS proxy server, if any. Left at 0 when no "
"proxy is used. Unrelated to the relay/server port above."
msgstr "Порт на междинен HTTP/SOCKS прокси сървър, ако има такъв. Оставено на 0, когато не се използва прокси. Не е свързано с релейния/сървърния порт по-горе."

#: addon\globalPlugins\remoteClient\dialogs.py:453
msgid "Proxy &type:"
msgstr "Прокси &тип:"

#: addon\globalPlugins\remoteClient\dialogs.py:458
msgid "Proxy &username:"
msgstr "Прокси &потребителско име:"

#: addon\globalPlugins\remoteClient\dialogs.py:462
msgid "Proxy pass&word:"
msgstr "Прокси пропуск&дума:"

#. Translators: A checkbox in add-on options dialog to set whether sounds play instead of beeps.
#: addon\globalPlugins\remoteClient\dialogs.py:467
msgid "Play sounds instead of beeps"
msgstr "Възпроизвеждай звуци вместо бибипкания"

#. Translators: A checkbox in add-on options dialog to set whether to display an alert before the controlled computer disconnects.
#: addon\globalPlugins\remoteClient\dialogs.py:470
msgid "Display an alert before the controlled computer disconnects"
msgstr ""
"Показвай предупреждение, преди връзката с контролирания компютър да бъде "
"прекъсната"

#. Translators: A checkbox in add-on options dialog to set whether to mute remote speech when controlling the local machine.
#: addon\globalPlugins\remoteClient\dialogs.py:473
msgid "Mute remote speech when controlling local machine"
msgstr ""
"Заглушавай речта от отдалечената машина при управление на локалната машина"

#. Translators: A checkbox in add-on options dialog to set whether allow or block speech commands
#: addon\globalPlugins\remoteClient\dialogs.py:476
msgid "Process speech commands when controlling another computer"
msgstr "Обработвай речеви команди при управление на друг компютър"

#. Translators: A checkbox in add-on options dialog to set whether server welcome messages are displayed only once
#: addon\globalPlugins\remoteClient\dialogs.py:479
msgid "Show server welcome messages only once"
msgstr "Показвай приветствените съобщения от сървъра само веднъж"

#. Translators: a text field in add-on options dialog to set the portcheck service URL
#: addon\globalPlugins\remoteClient\dialogs.py:482
msgid "Portcheck &service URL: "
msgstr "URL адрес на &услугата Portcheck: "

#. Translators: A button in add-on options dialog to delete all fingerprints of unauthorized certificates.
#: addon\globalPlugins\remoteClient\dialogs.py:486
msgid "Delete all trusted fingerprints"
msgstr "Изтрий всички доверени отпечатъци"

#. Translators: Label for the folder where received screenshots are saved.
#: addon\globalPlugins\remoteClient\dialogs.py:490
msgid "Screenshot save &folder:"
msgstr "Запазване на екранна снимка &папка:"

#. Translators: Button used to choose the folder where received screenshots are saved.
#: addon\globalPlugins\remoteClient\dialogs.py:495
msgid "&Browse..."
msgstr "&Преглед..."

#: addon\globalPlugins\remoteClient\dialogs.py:594
msgid ""
"When connecting to an unauthorized server, you will again be prompted to "
"accepts its certificate."
msgstr ""
"Когато се свързвате към неоторизиран сървър, отново ще бъдете подканени да "
"приемете неговия сертификат."

#: addon\globalPlugins\remoteClient\dialogs.py:594
msgid "Are you sure you want to delete all stored trusted fingerprints?"
msgstr ""
"Сигурни ли сте, че искате да изтриете всички съхранени доверени отпечатъци?"

#: addon\globalPlugins\remoteClient\dialogs.py:607
msgid "Choose the folder where received screenshots will be saved"
msgstr "Изберете папката, в която ще бъдат запазени получените екранни снимки"

#. Translators: error message for invalid format on Portcheck service URL
#: addon\globalPlugins\remoteClient\dialogs.py:629
#, python-brace-format
msgid ""
"Invalid format for portcheck service URL. You must include {port} somewhere."
msgstr ""
"Невалиден формат за URL адреса на услугата Portcheck. Трябва да включите "
"{port} някъде."

#: addon\globalPlugins\remoteClient\dialogs.py:637
msgid ""
"Invalid inactivity duration. Use the format jj:hh:mm, for example 30:00:00 "
"or 00:00:01."
msgstr "Невалидна продължителност на неактивност. Използвайте формата jj:hh:mm, например 30:00:00 или 00:00:01."

#. Translators: A title bar of a window presented when an attempt has been made to connect with a server with unauthorized certificate.
#: addon\globalPlugins\remoteClient\dialogs.py:706
msgid "TeleNVDA Connection Security Warning"
msgstr "Предупреждение за сигурността на връзката на TeleNVDA"

#. Translators: A message of a window presented when an attempt has been made to connect with a server with unauthorized certificate.
#: addon\globalPlugins\remoteClient\dialogs.py:708
#, python-brace-format
msgid ""
"Warning! The certificate of this server could not be verified.\n"
"This connection may not be secure. It is possible that someone is trying to "
"overhear your communication.\n"
"Before continuing please make sure that the following server certificate "
"fingerprint is a proper one.\n"
"If you have any questions, please contact the server administrator.\n"
"\n"
"Server SHA256 fingerprint: {fingerprint}\n"
"\n"
"Do you want to continue connecting?"
msgstr ""
"Внимание! Сертификатът на този сървър не може да бъде проверен.\n"
"Тази връзка може да не е защитена. Възможно е някой да се опитва да "
"подслушва комуникацията ви.\n"
"Преди да продължите, моля, уверете се, че отпечатъкът на следния сървърен "
"сертификат е правилен.\n"
"Ако имате въпроси, моля, свържете се с администратора на сървъра.\n"
"\n"
"SHA256 отпечатък на сървъра: {fingerprint}\n"
"\n"
"Искате ли да продължите със свързването?"

#: addon\globalPlugins\remoteClient\dialogs.py:710
msgid "Connect and do not ask again for this server"
msgstr "Свържи се и не питай отново за този сървър"

#. Translators: Title of the connect dialog.
#: addon\globalPlugins\remoteClient\dialogs.py:710
#: addon\globalPlugins\remoteClient\__init__.py:823
msgid "Connect"
msgstr "Свързване"

#: addon\globalPlugins\remoteClient\local_machine.py:156
msgid "Clipboard updated"
msgstr "Клипбордът е обновен"

#. Translators: Sent when a user fails to send CTRL+ALT+DEL from a remote NVDA instance
#: addon\globalPlugins\remoteClient\local_machine.py:169
msgid "No permission on device to trigger CTRL+ALT+DEL from remote"
msgstr ""
"Няма разрешение на устройството за задействане от разстояние на "
"Control+Alt+Delete"

#. Translators: message displayed in transfer file dialog when receiving a file
#: addon\globalPlugins\remoteClient\local_machine.py:248
msgid "Choose where to save the received file"
msgstr "Изберете къде да запазите получения файл"

#. Translators: supported file types when sending or receiving files
#: addon\globalPlugins\remoteClient\local_machine.py:252
#: addon\globalPlugins\remoteClient\__init__.py:580
msgid "All files (*.*)"
msgstr "Всички файлове (*.*)"

#. Translators: message spoken when the file has been received successfully
#: addon\globalPlugins\remoteClient\local_machine.py:263
msgid "File received"
msgstr "Файлът е получен"

#. translators: Message for version mismatch
#: addon\globalPlugins\remoteClient\session.py:54
msgid ""
"The version of the relay server which you have connected to is not "
"compatible with this version of the Remote Client.\n"
"Please either use a different server or upgrade your version of the addon."
msgstr ""
"Версията на препредаващия сървър, към който сте се свързали, не е съвместима "
"с тази версия на отдалечения клиент.\n"
"Моля, използвайте друг сървър или надстройте вашата версия на добавката."

#: addon\globalPlugins\remoteClient\session.py:62
msgid "Message of the Day"
msgstr "Съобщение за деня"

#: addon\globalPlugins\remoteClient\session.py:307
msgid "Remote NVDA not connected."
msgstr "Отдалеченият NVDA не е свързан."

#: addon\globalPlugins\remoteClient\url_handler.py:67
msgid "Invalid URL"
msgstr "Невалиден URL адрес"

#. Translators: Message shown when an invalid URL has been provided.
#: addon\globalPlugins\remoteClient\url_handler.py:69
#, python-format
msgid "Unable to parse url \"%s\""
msgstr "URL адресът \"%s\" не може да бъде анализиран синтактично"

#: addon\globalPlugins\remoteClient\__init__.py:121
msgid "Your NVDA Remote configuration was corrupted and has been reset."
msgstr "Конфигурацията на NVDA Remote е повредена и беше нулирана."

#: addon\globalPlugins\remoteClient\__init__.py:121
msgid "NVDA Remote Configuration Error"
msgstr "Грешка в конфигурацията на NVDA Remote"

#. Translators: Spoken when auto-connect is automatically disabled after a long period without remote control activity.
#: addon\globalPlugins\remoteClient\__init__.py:191
msgid ""
"The auto-connect option was automatically disabled after a long period "
"without any remote control activity."
msgstr "Опцията за автоматично свързване беше автоматично деактивирана след дълъг период от време без никакво дистанционно управление."

#: addon\globalPlugins\remoteClient\__init__.py:239
