msgstr "IP adresi başarıyla alındı. Port {port} açık."

#: addon\globalPlugins\remoteClient\dialogs.py:271
msgid "Success"
msgstr "Başarılı"

#: addon\globalPlugins\remoteClient\dialogs.py:273
#, python-brace-format
