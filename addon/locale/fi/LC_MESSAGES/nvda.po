#: addon\globalPlugins\remoteClient\dialogs.py:47
#: addon\globalPlugins\remoteClient\dialogs.py:136
#: addon\globalPlugins\remoteClient\dialogs.py:194
msgid "&Port:"
msgstr "&Portti:"

#. Translators: Label of the edit field to enter key (password) to secure the remote connection.
#: addon\globalPlugins\remoteClient\dialogs.py:51
#: addon\globalPlugins\remoteClient\dialogs.py:200
#: addon\globalPlugins\remoteClient\dialogs.py:416
msgid "&Key:"
msgstr "&Avain:"

#. Translators: The button used to generate a random key/password.
#: addon\globalPlugins\remoteClient\dialogs.py:55
#: addon\globalPlugins\remoteClient\dialogs.py:203
msgid "&Generate Key"
msgstr "&Luo avain"

#. Translators: Label of an edit field to enter a second password to exchange encrypted data.
#: addon\globalPlugins\remoteClient\dialogs.py:59
#: addon\globalPlugins\remoteClient\dialogs.py:207
#: addon\globalPlugins\remoteClient\dialogs.py:421
msgid "En&cryption password (optional):"
msgstr "En&salauksen salasana (valinnainen):"

#: addon\globalPlugins\remoteClient\dialogs.py:62
#: addon\globalPlugins\remoteClient\dialogs.py:145
#: addon\globalPlugins\remoteClient\dialogs.py:425
msgid "WebSocket &path:"
msgstr "WebSocket &polku:"

#: addon\globalPlugins\remoteClient\dialogs.py:85
#: addon\globalPlugins\remoteClient\dialogs.py:161
msgid "Host must be set."
msgstr "Isäntä on määritettävä."

#. Translators: error message caption
#: addon\globalPlugins\remoteClient\dialogs.py:85
#: addon\globalPlugins\remoteClient\dialogs.py:161
#: addon\globalPlugins\remoteClient\dialogs.py:280
#: addon\globalPlugins\remoteClient\dialogs.py:319
#: addon\globalPlugins\remoteClient\dialogs.py:323
#: addon\globalPlugins\remoteClient\dialogs.py:328
#: addon\globalPlugins\remoteClient\dialogs.py:333
