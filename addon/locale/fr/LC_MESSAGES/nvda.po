#: addon\installTasks.py:214
#, python-brace-format
msgid ""
"The following add-ons offer the same remote assistance as TeleNVDA and have "
"been removed to avoid conflicts: {addons}.\n"
"Their removal will be complete once NVDA has restarted."
msgstr ""
"Les extensions suivantes offrent la même assistance à distance que TeleNVDA "
"et ont été supprimées pour éviter les conflits : {addons}.\n"
"Leur suppression sera effective au prochain démarrage de NVDA."

#. Translators: title of the message reporting the removal of old add-ons
#: addon\installTasks.py:217
msgid "Old remote control add-ons removed"
msgstr "Anciennes extensions de prise de contrôle à distance supprimées"

#: addon\installTasks.py:260
msgid ""
"NVDA Remote has been detected on your NVDA installation. In order for "
"TeleNVDA to work without conflicts, NVDA Remote must be disabled. Otherwise, "
"TeleNVDA will refuse to work. Would you like to disable NVDA Remote now?"
msgstr ""
"L'Accès distant NVDA a été détecté sur votre installation NVDA. Pour que "
"TeleNVDA fonctionne sans conflits, l'Accès distant NVDA doit être désactivé. "
"Sinon, TeleNVDA refusera de fonctionner. Souhaitez-vous désactiver l'Accès "
"distant NVDA maintenant ?"

#. Translators: question title
#: addon\installTasks.py:263
msgid "Running NVDA Remote detected"
msgstr "Accès distant NVDA en cours d'exécution détecté"

#. Translators: message spoken when remote audio is turned off
#: addon\globalPlugins\remoteClient\audio_share.py:256
msgid "Remote audio stopped"
msgstr "Son distant arrêté"

#. Translators: message spoken when remote audio is requested from the wrong computer
#: addon\globalPlugins\remoteClient\audio_share.py:263
msgid "Remote audio can only be started from the controlling computer"
msgstr "Le son distant ne peut être démarré que depuis l'ordinateur contrôleur"

#. Translators: message spoken when remote audio cannot run on this computer
#: addon\globalPlugins\remoteClient\audio_share.py:266
msgid "Remote audio is not available on this computer"
msgstr "Le son distant n'est pas disponible sur cet ordinateur"

#. Translators: message spoken when Opus is unavailable locally
#: addon\globalPlugins\remoteClient\audio_share.py:269
msgid "Remote audio Opus is not available on this computer"
msgstr "Le son distant Opus n'est pas disponible sur cet ordinateur"

#. Translators: message spoken when the other computer cannot share Opus audio
#. Translators: message spoken when the other computer does not offer Opus
#: addon\globalPlugins\remoteClient\audio_share.py:273
#: addon\globalPlugins\remoteClient\audio_share.py:871
msgid "The other computer does not support Opus remote audio"
msgstr "L'autre ordinateur ne prend pas en charge le son distant Opus"

#. Translators: message spoken when remote audio has been requested
#: addon\globalPlugins\remoteClient\audio_share.py:287
msgid "Remote audio requested"
msgstr "Son distant demandé"

#: addon\globalPlugins\remoteClient\audio_share.py:600
msgid ""
"Do you want to share the sound of this computer? The controlling computer "
"will hear the applications playing here."
msgstr ""
"Souhaitez-vous partager le son de cet ordinateur ? L'ordinateur contrôleur "
"entendra les applications qui jouent ici."

#: addon\globalPlugins\remoteClient\audio_share.py:607
msgid ""
"Do you want to share the sound of this computer? This version of Windows "
"cannot separate the applications, so everything played here will be heard, "
"including the speech of this screen reader."
msgstr ""
"Souhaitez-vous partager le son de cet ordinateur ? Cette version de Windows "
"ne sait pas séparer les applications : tout ce qui est joué ici sera "
"entendu, y compris la parole de ce lecteur d'écran."

#. Translators: title of the remote audio request dialog
#: addon\globalPlugins\remoteClient\audio_share.py:612
msgid "Remote audio request"
msgstr "Demande de son distant"

#. Translators: message spoken when the sound of the whole computer is shared
#: addon\globalPlugins\remoteClient\audio_share.py:655
msgid "Sharing all the sound of this computer, including this speech"
msgstr "Partage de tout le son de cet ordinateur, y compris cette parole"

#. Translators: message spoken on the assisted computer when it starts sharing its sound
#: addon\globalPlugins\remoteClient\audio_share.py:658
msgid "Sharing the sound of this computer"
msgstr "Partage du son de cet ordinateur"

#. Translators: message spoken when the peer confirms invalid audio parameters
#: addon\globalPlugins\remoteClient\audio_share.py:692
msgid "The other computer sent invalid Opus audio parameters"
msgstr "L'autre ordinateur a envoyé des paramètres audio Opus non valides"

#. Translators: message spoken when the remote sound cannot be played here
#: addon\globalPlugins\remoteClient\audio_share.py:704
msgid "Unable to play the remote sound on this computer"
msgstr "Impossible de jouer le son distant sur cet ordinateur"

#. Translators: message spoken when the remote sound starts being heard
#: addon\globalPlugins\remoteClient\audio_share.py:709
msgid "Remote audio started"
msgstr "Son distant démarré"

#: addon\globalPlugins\remoteClient\audio_share.py:714
msgid ""
"This computer can only share all of its sound, including the speech of its "
"screen reader"
msgstr ""
"Cet ordinateur ne peut partager que tout son son, y compris la parole de son "
"lecteur d'écran"

#. Translators: message spoken when the other computer ended remote audio
#: addon\globalPlugins\remoteClient\audio_share.py:722
msgid "Remote audio ended"
msgstr "Son distant terminé"

#. Translators: message spoken when the other computer refused to share its sound
#: addon\globalPlugins\remoteClient\audio_share.py:865
msgid "The other computer refused to share its sound"
msgstr "L'autre ordinateur a refusé de partager son son"

#. Translators: message spoken when the other computer is already sharing its sound
#: addon\globalPlugins\remoteClient\audio_share.py:868
msgid "The other computer is already sharing its sound"
msgstr "L'autre ordinateur partage déjà son son"

#. Translators: message spoken when Opus cannot be loaded on the other computer
#: addon\globalPlugins\remoteClient\audio_share.py:874
msgid "Opus is not available on the other computer"
msgstr "Opus n'est pas disponible sur l'autre ordinateur"

#. Translators: message spoken when the other computer cannot share its sound
#: addon\globalPlugins\remoteClient\audio_share.py:876
msgid "The other computer is unable to share its sound"
msgstr "L'autre ordinateur ne peut pas partager son son"

#: addon\globalPlugins\remoteClient\dialogs.py:48
msgid "Standard (TCP)"
msgstr "Standard (TCP)"

#: addon\globalPlugins\remoteClient\dialogs.py:49
msgid "WebSocket over HTTPS"
msgstr "WebSocket sur HTTPS"

