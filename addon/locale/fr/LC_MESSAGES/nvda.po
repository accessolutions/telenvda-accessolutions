#: addon\globalPlugins\remoteClient\dialogs.py:407
#: addon\globalPlugins\remoteClient\dialogs.py:515
msgid "Connectivity test"
msgstr "Test de connectivité"

#: addon\globalPlugins\remoteClient\dialogs.py:411
msgid "Test a relay endpoint without joining a channel."
msgstr "Tester un point d'accès du relais sans rejoindre de canal."

#: addon\globalPlugins\remoteClient\dialogs.py:452
msgid "&Test"
msgstr "&Tester"

