msgid "HTTPS classique (compatible proxy)"
msgstr "HTTPS classique (compatible proxy)"

#: addon\globalPlugins\remoteClient\dialogs.py:54
msgid "Automatic (recommended)"
msgstr "Automatique (recommandé)"

#: addon\globalPlugins\remoteClient\dialogs.py:55
msgid "Version 1, long polling"
msgstr "Version 1, interrogation longue"

#: addon\globalPlugins\remoteClient\dialogs.py:56
msgid "Version 2, streaming"
msgstr "Version 2, flux continu"

#. Translators: Proxy mode where the user enters the proxy host, port and credentials manually.
#: addon\globalPlugins\remoteClient\dialogs.py:96
msgid "Manual configuration"
msgstr "Configuration manuelle"

#. Translators: Proxy mode where the proxy is read from the Windows system settings.
#: addon\globalPlugins\remoteClient\dialogs.py:98
