#: addon\globalPlugins\remoteClient\dialogs.py:110
msgid "4 hours"
msgstr "4 heures"

#: addon\globalPlugins\remoteClient\dialogs.py:111
msgid "8 hours"
msgstr "8 heures"

#. Translators: Option to prevent the computer from going to sleep without a time limit.
#: addon\globalPlugins\remoteClient\dialogs.py:113
msgid "Always prevent the computer from going to sleep"
msgstr "Toujours empêcher la mise en veille"

#: addon\globalPlugins\remoteClient\dialogs.py:121
#: addon\globalPlugins\remoteClient\dialogs.py:432
#: addon\globalPlugins\remoteClient\dialogs.py:774
msgid "&Transport:"
