"Port of an intermediary HTTP/SOCKS proxy server, if any. Left at 0 when no "
"proxy is used. Unrelated to the relay/server port above."
msgstr ""
"Port d'un serveur proxy HTTP/SOCKS intermédiaire, le cas échéant. Laissé à 0 "
"lorsqu'aucun proxy n'est utilisé. Sans lien avec le port du serveur/relais "
"ci-dessus."

#: addon\globalPlugins\remoteClient\dialogs.py:187
#: addon\globalPlugins\remoteClient\dialogs.py:850
msgid "Proxy &type:"
msgstr "&Type de proxy :"

#: addon\globalPlugins\remoteClient\dialogs.py:191
