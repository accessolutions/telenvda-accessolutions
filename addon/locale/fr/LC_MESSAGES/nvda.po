#. Translators: Label of an edit field to enter a second password to exchange encrypted data.
#: addon\globalPlugins\remoteClient\dialogs.py:147
#: addon\globalPlugins\remoteClient\dialogs.py:544
#: addon\globalPlugins\remoteClient\dialogs.py:805
msgid "En&cryption password (optional):"
msgstr "Mot de passe de &chiffrement (facultatif) :"

#: addon\globalPlugins\remoteClient\dialogs.py:150
#: addon\globalPlugins\remoteClient\dialogs.py:438
#: addon\globalPlugins\remoteClient\dialogs.py:809
msgid "WebSocket &path:"
msgstr "&Chemin WebSocket :"

#: addon\globalPlugins\remoteClient\dialogs.py:154
#: addon\globalPlugins\remoteClient\dialogs.py:442
#: addon\globalPlugins\remoteClient\dialogs.py:814
msgid "HTTPS relay &path:"
msgstr "&Chemin du relais HTTPS :"

#. Translators: Title of the group of proxy settings in the connect dialog.
#: addon\globalPlugins\remoteClient\dialogs.py:168
msgid "Proxy"
msgstr "Proxy"

#: addon\globalPlugins\remoteClient\dialogs.py:170
#: addon\globalPlugins\remoteClient\dialogs.py:830
