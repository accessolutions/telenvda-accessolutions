#. Translators: Used in server mode to obtain the external IP address for the server (controlled computer) for direct connection.
#: addon\globalPlugins\remoteClient\dialogs.py:523
msgid "Get External &IP"
msgstr "&Obtenir l'adresse IP publique"

#. Translators: Label of the field displaying the external IP address if using direct (client to server) connection.
#: addon\globalPlugins\remoteClient\dialogs.py:527
msgid "&External IP:"
msgstr "&IP publique :"

#. Translators: label of a checkbox which allows forwarding a port using UPNP
#: addon\globalPlugins\remoteClient\dialogs.py:535
#: addon\globalPlugins\remoteClient\dialogs.py:797
msgid "Use &UPNP to forward this port if possible"
msgstr "Utiliser &UPNP pour rediriger ce port si possible"

#. Translators: message asking the user wether perform portcheck with UPNP or not
#: addon\globalPlugins\remoteClient\dialogs.py:562
msgid ""
"Would you like to use UPNP to forward the chosen port before detecting your "
"IP address?"
msgstr ""
"Souhaitez-vous utiliser UPNP pour rediriger le port choisi avant de détecter "
"votre adresse IP ?"

#. Translators: title of the message asking the user to try portcheck with UPNP
#: addon\globalPlugins\remoteClient\dialogs.py:564
msgid "Do you want to use UPNP?"
msgstr "Voulez-vous utiliser UPNP ?"

#: addon\globalPlugins\remoteClient\dialogs.py:611
#, python-brace-format
msgid "Successfully retrieved IP address. Port {port} is open."
msgstr "Adresse IP récupérée avec succès. Le port {port} est ouvert."

#: addon\globalPlugins\remoteClient\dialogs.py:612
msgid "Success"
msgstr "Succès"

#: addon\globalPlugins\remoteClient\dialogs.py:617
#, python-brace-format
msgid "Retrieved external IP, but port {port} is not currently forwarded."
msgstr ""
"Adresse IP publique récupérée, mais le port {port} n'est actuellement pas "
"redirigé."

#. Translators: The title of the warning dialog displayed when handle keys from other applications is disabled.
#: addon\globalPlugins\remoteClient\dialogs.py:620
#: addon\globalPlugins\remoteClient\__init__.py:1925
msgid "Warning"
msgstr "Avertissement"

#: addon\globalPlugins\remoteClient\dialogs.py:630
msgid ""
"Unable to contact portcheck server or UPNP device, please manually retrieve "
"your IP address and forward ports if required. See the NVDA log for more "
"details."
msgstr ""
"Impossible de contacter le serveur portcheck ou un périphérique UPNP, "
"veuillez récupérer manuellement votre adresse IP et rediriger vos ports si "
"nécessaire. Voir le journal NVDA pour plus de détails."

#: addon\globalPlugins\remoteClient\dialogs.py:644
msgid "Client"
msgstr "Client"

#: addon\globalPlugins\remoteClient\dialogs.py:644
msgid "Server"
msgstr "Serveur"

#: addon\globalPlugins\remoteClient\dialogs.py:650
#: addon\globalPlugins\remoteClient\dialogs.py:746
msgid "Allow this machine to be controlled"
msgstr "Permettre le contrôle de cet ordinateur"

#: addon\globalPlugins\remoteClient\dialogs.py:650
#: addon\globalPlugins\remoteClient\dialogs.py:746
msgid "Control another machine"
msgstr "Contrôler un autre ordinateur"

#: addon\globalPlugins\remoteClient\dialogs.py:678
#: addon\globalPlugins\remoteClient\dialogs.py:1313
msgid "Both host and key must be set."
msgstr "L'adresse du serveur et la clé doivent être tous deux renseignés."

#: addon\globalPlugins\remoteClient\dialogs.py:683
#: addon\globalPlugins\remoteClient\dialogs.py:705
#: addon\globalPlugins\remoteClient\dialogs.py:1321
msgid "The key must be longer than 6 characters."
msgstr "La clé doit compter plus de 6 caractères."

#: addon\globalPlugins\remoteClient\dialogs.py:692
#: addon\globalPlugins\remoteClient\dialogs.py:714
#: addon\globalPlugins\remoteClient\dialogs.py:1330
msgid ""
"The key must not be sequential. Please, avoid keys such as 1234, 4321 or "
"similar."
msgstr ""
"La clé ne doit pas être séquentielle. Veuillez éviter les clés telles que "
"1234, 4321 ou similaires."

#: addon\globalPlugins\remoteClient\dialogs.py:700
#: addon\globalPlugins\remoteClient\dialogs.py:1316
msgid "Both port and key must be set."
msgstr "Le port et la clé doivent être tous deux renseignés."

#. Translators: title for the TeleNVDA settings category in NVDA settings dialog
#. Translators: script category for add-on gestures
#: addon\globalPlugins\remoteClient\dialogs.py:725
#: addon\globalPlugins\remoteClient\__init__.py:185
#: addon\globalPlugins\remoteClient\__init__.py:865
msgid "TeleNVDA"
msgstr "TeleNVDA"

#. Translators: A checkbox in add-on options dialog to set whether remote server is started when NVDA starts.
#: addon\globalPlugins\remoteClient\dialogs.py:729
msgid "Auto-connect to control server on startup"
msgstr "Se connecter automatiquement au serveur de contrôle au démarrage"

#. Translators: A checkbox in add-on options dialog to enable update checks when NVDA starts.
#: addon\globalPlugins\remoteClient\dialogs.py:733
msgid "Check for TeleNVDA updates on startup"
msgstr "Vérifier les mises à jour de TeleNVDA au démarrage"

#: addon\globalPlugins\remoteClient\dialogs.py:739
msgid "Use Remote Control Server"
msgstr "Utiliser un serveur de contrôle distant"

#: addon\globalPlugins\remoteClient\dialogs.py:739
msgid "Host Control Server"
msgstr "Héberger le serveur de contrôle"

#: addon\globalPlugins\remoteClient\dialogs.py:755
msgid "Automatically disable auto-connect without any remote control activity"
msgstr ""
"Désactiver automatiquement la connexion automatique sans aucune activité de "
"contrôle à distance"

#. Translators: Label for the inactivity duration field. The value uses days:hours:minutes.
#: addon\globalPlugins\remoteClient\dialogs.py:761
msgid "Inactivity duration (days:hours:minutes):"
msgstr "Durée d'inactivité (jours:heures:minutes) :"

#: addon\globalPlugins\remoteClient\dialogs.py:770
msgid ""
"Format: days:hours:minutes. For example, 30:00:00 means 30 days and 00:00:01 "
"means 1 minute."
msgstr ""
"Format : jours:heures:minutes. Par exemple, 30:00:00 signifie 30 jours et "
"00:00:01 signifie 1 minute."

#. Translators: label of the port used to reach the relay or server, as opposed to the proxy port below.
#: addon\globalPlugins\remoteClient\dialogs.py:786
msgid "&Port (server/relay):"
msgstr "&Port (serveur/relais) :"

#: addon\globalPlugins\remoteClient\dialogs.py:792
msgid ""
"Port used to reach the relay or server (default 6837, or 443 for WebSocket "
"over HTTPS or HTTPS classic). Unrelated to the proxy port below."
msgstr ""
"Port utilisé pour joindre le relais ou le serveur (par défaut 6837, ou 443 "
"pour WebSocket sur HTTPS ou HTTPS classique). Sans lien avec le port du "
"proxy ci-dessous."

#: addon\globalPlugins\remoteClient\dialogs.py:819
msgid "HTTPS relay version:"
msgstr "Version du relais HTTPS :"

#: addon\globalPlugins\remoteClient\dialogs.py:825
msgid "HTTPS v2 relay path:"
msgstr "Chemin du relais HTTPS &v2 :"

#. Translators: A checkbox in add-on options dialog to set whether sounds play instead of beeps.
#: addon\globalPlugins\remoteClient\dialogs.py:864
msgid "Play sounds instead of beeps"
msgstr "Jouer des sons à la place des bips"

#: addon\globalPlugins\remoteClient\dialogs.py:870
msgid "Display an alert before the controlled computer disconnects"
msgstr "Afficher une alerte avant que l'ordinateur contrôlé ne se déconnecte"

#: addon\globalPlugins\remoteClient\dialogs.py:877
msgid "Mute remote speech when controlling local machine"
msgstr ""
"Couper la synthèse vocale distante lors du contrôle de la machine locale"

#: addon\globalPlugins\remoteClient\dialogs.py:884
msgid "Process speech commands when controlling another computer"
msgstr ""
"Traiter les commandes de la synthèse vocale lors du contrôle d'un autre "
"ordinateur"

#. Translators: A checkbox in add-on options dialog to set whether server welcome messages are displayed only once
#: addon\globalPlugins\remoteClient\dialogs.py:888
msgid "Show server welcome messages only once"
msgstr "Afficher les messages de bienvenue du serveur une seule fois"

#: addon\globalPlugins\remoteClient\dialogs.py:892
msgid "Number of successful connection keys to remember:"
msgstr "Nombre de clés des connexions réussies à mémoriser :"

#: addon\globalPlugins\remoteClient\dialogs.py:905
msgid "Prevent this computer from going to sleep when it is not used"
msgstr ""
"Empêcher l’ordinateur de se mettre en veille lorsqu’il n’est pas utilisé"

#: addon\globalPlugins\remoteClient\dialogs.py:914
msgid "Delay without activity before keeping the computer awake (in seconds):"
msgstr ""
"Délai d’inactivité avant de maintenir l’ordinateur actif (en secondes) :"

#: addon\globalPlugins\remoteClient\dialogs.py:924
msgid "Maximum duration for preventing the computer from going to sleep:"
msgstr ""
"Durée maximale pendant laquelle empêcher l’ordinateur de se mettre en "
"veille :"

#: addon\globalPlugins\remoteClient\dialogs.py:935
msgid ""
"Allow files larger than 10 MB even when the other computer does not support "
"the new transfer system"
msgstr ""
"Autoriser les fichiers de plus de 10 Mo même lorsque l'autre ordinateur ne "
"prend pas en charge le nouveau système de transfert"

#. Translators: Label for the maximum size of a file sent without the new transfer system.
#: addon\globalPlugins\remoteClient\dialogs.py:941
msgid "Maximum size of those transfers (in MB):"
msgstr "Taille maximale de ces transferts (en Mo) :"

#: addon\globalPlugins\remoteClient\dialogs.py:949
msgid "Maximum size of received files, in MB (0 for no limit):"
msgstr "Taille maximale des fichiers reçus, en Mo (0 pour aucune limite) :"

#: addon\globalPlugins\remoteClient\dialogs.py:958
msgid ""
"Allow sharing the screen of this computer and the use of its mouse, after "
"confirmation"
msgstr ""
"Autoriser le partage de l'écran de cet ordinateur et l'utilisation de sa "
"souris, après confirmation"

#. Translators: Label for the maximum number of images per second sent while sharing the screen.
#: addon\globalPlugins\remoteClient\dialogs.py:963
msgid "Maximum number of images per second:"
msgstr "Nombre maximal d'images par seconde :"

#: addon\globalPlugins\remoteClient\dialogs.py:968
msgid "Reduce the shared picture to this width, in pixels:"
msgstr "Réduire l'image partagée à cette largeur, en pixels :"

