"Unable to check for TeleNVDA updates.\n"
"\n"
"{error}"
msgstr "No se pueden comprobar las actualizaciones de TeleNVDA.\n\n{error}"

#: addon\globalPlugins\remoteClient\__init__.py:290
msgid "TeleNVDA is up to date."
msgstr "TeleNVDA está actualizado."

#: addon\globalPlugins\remoteClient\__init__.py:296
#, python-brace-format
msgid ""
"A TeleNVDA {channel} update is available: version {version}.\n"
"\n"
"Do you want to download and install it now?"
msgstr "Hay disponible una actualización de TeleNVDA {channel}: versión {version}.\n\n¿Quieres descargarla e instalarla ahora?"

#: addon\globalPlugins\remoteClient\__init__.py:299
msgid "development"
msgstr "desarrollo"

#: addon\globalPlugins\remoteClient\__init__.py:299
msgid "stable"
msgstr "estable"

#: addon\globalPlugins\remoteClient\__init__.py:308
msgid "Another TeleNVDA update operation is already in progress."
msgstr "Otra operación de actualización de TeleNVDA ya está en curso."

#: addon\globalPlugins\remoteClient\__init__.py:327
#, python-brace-format
msgid ""
"Unable to download or verify the TeleNVDA update.\n"
"\n"
"{error}"
msgstr "No se puede descargar o verificar la actualización de TeleNVDA.\n\n{error}"

